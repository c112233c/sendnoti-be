HOST=0.0.0.0
PORT=3001
# Default permits local requests only. Add trusted client IPs/CIDRs as required.
TRUSTED_NETWORKS=127.0.0.1/32,::1/128

# Generic Teams webhook for projects that do not provide routing metadata.
MSTEAM_WEBHOOK_URL=

# CBTDMS Teams webhooks are selected by the first 2 digits of aoj_code.
# Example: aoj_code "0512345" uses MSTEAM_CBTDMS_WEBHOOK_URL_05.
MSTEAM_CBTDMS_WEBHOOK_URL=
MSTEAM_CBTDMS_WEBHOOK_URL_04=
MSTEAM_CBTDMS_WEBHOOK_URL_05=
# Add more AOJ prefixes as required, e.g. MSTEAM_CBTDMS_WEBHOOK_URL_06=
